TZ=Europe/Lisbon
CAREER_DEFAULT_COUNTRY=Portugal
NODE_ENV=production
# Permanece false ate uma homologacao humana deliberada de UMA candidatura.
CAREER_SUBMISSION_ENABLED=false
# Cofres com envio controlado (consentimento por candidatura), separados por virgula: catho,vagas,...
# Vazio por padrao: Indeed, InfoJobs e GeekHunter proibem automacao nos termos de uso; libere sabendo do
# risco de bloqueio da conta. Sem a confirmacao capturada do portal, o envio fica incerto ate voce confirmar.
CAREER_VAULT_SUBMIT_PROVIDERS=
# IA local (Ollama/LM Studio, a mesma da Inteligencia) na ultima milha dos Cofres: escolhe entre os botoes
# listados quando o perfil do portal nao decide e confirma o texto de sucesso novo. Travas deterministicas
# continuam valendo; sem IA ou fora das travas o envio fica incerto como antes.
CAREER_LAST_MILE_LLM=false
# Para a primeira subida do servidor, pausa agendas, recuperacoes e mutacoes,
# exceto renovacao explicita de sessoes em Cofres. Nao muda preferencias salvas.
# normal: operacao completa; maintenance: consulta; manual: comandos mobile sem agendas/canais.
CAREER_OPERATION_MODE=normal
# Proxy privado: habilite apenas com bind loopback e identidade Tailscale.
CAREER_WEB_TRUST_PROXY=false
CAREER_WEB_ALLOWED_TAILSCALE_USERS=
CAREER_WEB_PROXY_ADDRESSES=
# URL HTTPS privada acessivel pelo celular (por exemplo Tailscale Serve).
# Nao exponha o Hub sem controle de acesso para a internet.
CAREER_PUBLIC_URL=http://127.0.0.1:7123

# Gateway Android. Publique esta porta somente por Tailscale Serve e informe
# os logins exatos da tailnet separados por vírgula.
MOBILE_GATEWAY_ENABLED=false
MOBILE_GATEWAY_ALLOWED_TAILSCALE_USERS=
# Quando trust proxy estiver habilitado: IP exato do proxy; fallback CAREER_WEB_PROXY_ADDRESSES.
MOBILE_GATEWAY_PROXY_ADDRESSES=
# Opcional: chave completa de uma app capability definida na policy Tailscale.
MOBILE_GATEWAY_REQUIRED_CAPABILITY=

# Gere valores longos e aleatorios. Nunca versione o arquivo .env real.
CAREER_N8N_WEBHOOK_SECRET=
N8N_ENCRYPTION_KEY=
EVOLUTION_API_KEY=
EVOLUTION_HOST_PORT=8081
EVOLUTION_MANAGER_URL=http://127.0.0.1:8081/manager
EVOLUTION_LOG_LEVEL=ERROR
EVOLUTION_LOG_BAILEYS=error
CAREER_EVOLUTION_WEBHOOK_SECRET=
BRAVE_SEARCH_API_KEY=
GITHUB_TOKEN=
EVOLUTION_POSTGRES_PASSWORD=

EVOLUTION_POSTGRES_USER=evolution
EVOLUTION_POSTGRES_DB=evolution
EVOLUTION_INSTANCE_NAME=career-unified
# Numero WhatsApp no formato internacional, apenas digitos. Ex.: 5511999999999
CAREER_WHATSAPP_TARGET=
# Remetente autorizado a aprovar. Obrigatorio quando o destino for grupo.
CAREER_WHATSAPP_APPROVER=
# Tempo maximo para a LLM sugerir resposta de formulario antes do handoff no WhatsApp.
CAREER_QUESTION_LLM_TIMEOUT_MS=12000
# Origens exatas da LLM no seu PC via Tailscale, separadas por virgula.
# Exemplo: http://100.64.0.10:1234. Vazio permite apenas localhost.
CAREER_LLM_ALLOWED_ORIGINS=

# Optional: official GitHub OAuth App with device flow enabled. Never required.
GITHUB_OAUTH_CLIENT_ID=
LOG_RETENTION_DAYS=30
LOG_MAX_ROWS=5000

# Discovery incremental. Limites pequenos e observáveis por execução.
CAREER_REMOTAR_PAGES_PER_RUN=2
CAREER_REMOTAR_PAGE_DELAY_MS=250
CAREER_NERDIN_URLS_PER_RUN=30

# Semantic fallback local e opcional. O matcher determinístico funciona sozinho.
SEMANTIC_MATCHER_ENABLED=false
SEMANTIC_LLM_PROVIDER=ollama
SEMANTIC_LLM_BASE_URL=http://localhost:11434
SEMANTIC_LLM_MODEL=
SEMANTIC_LLM_TIMEOUT_MS=20000
